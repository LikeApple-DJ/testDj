<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.antdigital.todo.dao.mapper.TodoItemMapper">

    <!-- 结果映射 -->
    <resultMap id="TodoItemResultMap" type="com.antdigital.todo.model.entity.TodoItemDO">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="title" property="title" jdbcType="VARCHAR"/>
        <result column="description" property="description" jdbcType="VARCHAR"/>
        <result column="creator" property="creator" jdbcType="VARCHAR"/>
        <result column="gmt_create" property="gmtCreate" jdbcType="TIMESTAMP"/>
        <result column="gmt_modified" property="gmtModified" jdbcType="TIMESTAMP"/>
    </resultMap>

    <!-- 插入待办事项，使用 useGeneratedKeys 回填主键 -->
    <insert id="insert" parameterType="com.antdigital.todo.model.entity.TodoItemDO"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO todo_item (title, description, creator, gmt_create, gmt_modified)
        VALUES (#{title}, #{description}, #{creator}, #{gmtCreate}, #{gmtModified})
    </insert>

    <!-- 根据ID查询 -->
    <select id="selectById" resultMap="TodoItemResultMap">
        SELECT id, title, description, creator, gmt_create, gmt_modified
        FROM todo_item
        WHERE id = #{id}
    </select>

</mapper>
